{
  "expo": {
    "name": "KAMPUS",
    "slug": "kampus-student-life-app",
    "scheme": "kampus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kampus.studentlife",
      "infoPlist": {
        "NSCameraUsageDescription": "KAMPUS needs camera access for document scanning and QR code verification.",
        "NSPhotoLibraryUsageDescription": "KAMPUS needs photo library access to upload study notes and profile avatars."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.kampus.studentlife",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "kampus"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "clerkPublishableKey": "pk_test_b3JpZW50ZWQtamVubmV0LTU5NDUuY2xlcmsuYWNjb3VudHMuZGV2JA",
      "eas": {
        "projectId": "13acd386-0e49-44ab-aed0-6e93a334e132"
      }
    },
    "owner": "kampusstudent2026s-team"
  }
}
