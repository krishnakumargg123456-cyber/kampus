  id: 'usr_22b030149',
  name: CURRENT_STUDENT.name,
  email: CURRENT_STUDENT.email,
  mobile: CURRENT_STUDENT.mobile,
  college: CURRENT_STUDENT.college,
  course: CURRENT_STUDENT.course,
  semester: CURRENT_STUDENT.semester,
  enrollmentNo: CURRENT_STUDENT.enrollmentNo,
  avatarUrl: CURRENT_STUDENT.avatarUrl,
  hasCompletedOnboarding: true,
  isVerified: true,
  role: 'student',
};

export const EMPTY_STUDENT_PROFILE: StudentProfile = {
  name: '',
  email: '',
  mobile: '',
  avatarUrl: '',
  college: '',
  course: '',
  semester: '',
  enrollmentNo: '',
  isVerified: false,
  cgpa: 0,
  learningProgress: 0,
  studyStreakDays: 0,
  todayStudyHours: 0,
  karmaPoints: 0,
  bio: '',
  interests: [],
};

const AuthContext = createContext<AuthContextType | undefined>(undefined);

function getClerkErrorMessage(err: any): string {
  if (err?.errors && err.errors.length > 0) {
    const first = err.errors[0];
    const code = first.code;
    const msg = first.longMessage || first.message;

    // Map common Clerk error codes to friendly student guidance
    if (code === 'form_identifier_not_found') {
      return 'No student account was found with this email. Please check your spelling or register.';
    }
    if (code === 'form_password_incorrect') {
      return 'Incorrect password. Please verify your credentials or use "Forgot password".';
    }
    if (code === 'form_identifier_exists') {
      return 'An account with this email address already exists. Please sign in instead.';
    }
    if (code === 'form_password_pwned') {
      return 'This password has been flagged in public security breaches. Please choose a more unique password.';
    }
    if (code === 'form_code_incorrect') {
      return 'The 6-digit verification code is incorrect. Please check your inbox and try again.';
    }
    if (code === 'verification_expired') {
      return 'This verification code has expired. Please click "Resend code" to receive a fresh one.';
    }
    if (code === 'form_password_length_too_short') {
      return 'Your password must be at least 8 characters long.';
    }
    return msg || 'Authentication error';
  }
  return err?.message || 'Authentication failed. Please check your credentials.';
}

/**
 * Clerk Integrated Inner Provider (Used when VITE_CLERK_PUBLISHABLE_KEY is valid)
 */
const ClerkIntegratedAuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const { isLoaded: isUserLoaded, isSignedIn, user: clerkUser } = useUser();
  const { getToken } = useClerkAuth();
  const { signIn, setActive: setSignInActive, isLoaded: isSignInLoaded } = useSignIn();
  const { signUp, setActive: setSignUpActive, isLoaded: isSignUpLoaded } = useSignUp();
  const clerk = useClerk();

  const [token, setToken] = useState<string | null>(() => localStorage.getItem('kampus_token'));
  const [pendingEmail, setPendingEmail] = useState<string>('');
  const [user, setUser] = useState<UserAuthData | null>(() => {
    try {
      const saved = localStorage.getItem('kampus_auth_user');
      if (saved) {
        const parsed = JSON.parse(saved);
        if (parsed.id === 'usr_22b030149' && parsed.email === 'priya.sharma@cse.iitb.ac.in') {
          return null;
        }
        return parsed;
      }
      return null;
    } catch {
      return null;
    }
  });

  const [profile, setProfile] = useState<StudentProfile>(() => {
    try {
      const saved = localStorage.getItem('kampus_student_profile');
      if (saved) {
        const parsed = JSON.parse(saved);
        if (parsed.email === 'priya.sharma@cse.iitb.ac.in' || parsed.name === 'Priya Sharma') {
          return EMPTY_STUDENT_PROFILE;
        }
        return parsed;
      }
      return EMPTY_STUDENT_PROFILE;
    } catch {
      return EMPTY_STUDENT_PROFILE;
    }
  });

  // Synchronize Clerk user identity with KAMPUS student backend
  const syncClerkWithBackend = useCallback(
    async (
      clerkId: string,
      email?: string,
      name?: string,
      avatarUrl?: string,
      additionalMeta?: Partial<UserAuthData>
    ) => {
      try {
        const sessionToken = await getToken();
        if (sessionToken) {
          setToken(sessionToken);
          localStorage.setItem('kampus_token', sessionToken);
        }

        // Merge any pre-saved pending registration academic details
        let meta: any = additionalMeta || {};
        try {
          const raw = localStorage.getItem('kampus_pending_registration_meta');
          if (raw) {
            meta = { ...JSON.parse(raw), ...meta };
          }
        } catch {
          // ignore
        }

        const effectiveEmail = email || clerkUser?.primaryEmailAddress?.emailAddress || meta.email;
        const effectiveFullName = name || clerkUser?.fullName || clerkUser?.firstName || meta.name;

        const res = await fetch('/api/auth/sync-profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            clerkId,
            email: effectiveEmail,
            fullName: effectiveFullName,
            avatarUrl: avatarUrl || clerkUser?.imageUrl,
            college: meta.college,
            course: meta.course,
            branch: meta.branch,
            semester: meta.semester,
            enrollmentNo: meta.enrollmentNo,
          }),
        });

        if (res.ok) {
          const data = await res.json();
          if (data.user) {
            const u = data.user;
            const mappedUser: UserAuthData = {
              id: u.userId || u.id || clerkId,
              clerkId: u.clerkId || clerkId,
              name: u.fullName || u.name || effectiveFullName || 'KAMPUS Student',
              email: u.email || effectiveEmail || '',
              mobile: u.mobile || meta.mobile || '',
              college: u.college || meta.college || '',
              course: u.course || meta.course || '',
              semester: u.semester || meta.semester || '',
              enrollmentNo: u.enrollmentNo || meta.enrollmentNo || '',
              avatarUrl: resolveAssetUrl(u.avatarUrl) || clerkUser?.imageUrl || '',
              hasCompletedOnboarding: data.hasCompletedOnboarding ?? (!!u.college && !!u.course),
              isVerified: true,
              role: u.role || 'student',
            };

            setUser(mappedUser);
            localStorage.setItem('kampus_auth_user', JSON.stringify(mappedUser));

            setProfile((prev) => {
              const isDemo = prev.email === 'priya.sharma@cse.iitb.ac.in' || prev.name === 'Priya Sharma';
              const base = isDemo ? EMPTY_STUDENT_PROFILE : prev;
              const updated: StudentProfile = {
                ...base,
                name: mappedUser.name,
                email: mappedUser.email,
                avatarUrl: mappedUser.avatarUrl || base.avatarUrl,
                college: mappedUser.college || base.college,
                course: mappedUser.course || base.course,
                semester: mappedUser.semester || base.semester,
                enrollmentNo: mappedUser.enrollmentNo || base.enrollmentNo,
                bio: u.bio || base.bio,
                interests: u.interests || base.interests,
              };
              localStorage.setItem('kampus_student_profile', JSON.stringify(updated));
              return updated;
            });

            // Clean up temporary meta once synchronized
            localStorage.removeItem('kampus_pending_registration_meta');
          }
        }
      } catch (err) {
        console.warn('[Clerk Sync Warning]:', err);
      }
    },
    [clerkUser, getToken]
  );

  useEffect(() => {
    if (isSignedIn && clerkUser) {
      const clerkRealName =
        clerkUser.fullName ||
        (clerkUser.firstName ? `${clerkUser.firstName} ${clerkUser.lastName || ''}`.trim() : '') ||
        clerkUser.username ||
        clerkUser.primaryEmailAddress?.emailAddress?.split('@')[0] ||
        'KAMPUS Student';
      const clerkRealEmail = clerkUser.primaryEmailAddress?.emailAddress || '';
      const clerkAvatar = clerkUser.imageUrl || '';

      // Immediately hydrate user state from Clerk session
      setUser((current) => {
        const isDemo = current?.id === 'usr_22b030149' || current?.email === 'priya.sharma@cse.iitb.ac.in';
        const base = isDemo ? null : current;

        let pendingMeta: any = {};
        try {
          const raw = localStorage.getItem('kampus_pending_registration_meta');
          if (raw) pendingMeta = JSON.parse(raw);
        } catch {
          // ignore
        }

        const updated: UserAuthData = {
          id: base?.id && base.id !== 'usr_22b030149' ? base.id : clerkUser.id,
          clerkId: clerkUser.id,
          name: clerkRealName || pendingMeta.name || base?.name || 'KAMPUS Student',
          email: clerkRealEmail || pendingMeta.email || base?.email || '',
          mobile: clerkUser.primaryPhoneNumber?.phoneNumber || pendingMeta.mobile || base?.mobile || '',
          college: base?.college || pendingMeta.college || '',
          course: base?.course || pendingMeta.course || '',
          semester: base?.semester || pendingMeta.semester || '',
          enrollmentNo: base?.enrollmentNo || pendingMeta.enrollmentNo || '',
          avatarUrl: clerkAvatar || base?.avatarUrl || '',
          hasCompletedOnboarding: base?.hasCompletedOnboarding ?? false,
          isVerified: true,
          role: base?.role || 'student',
        };
        localStorage.setItem('kampus_auth_user', JSON.stringify(updated));
        return updated;
      });

      // Also hydrate profile so it immediately reflects user's actual identity
      setProfile((prev) => {
        const isDemo = prev.email === 'priya.sharma@cse.iitb.ac.in' || prev.name === 'Priya Sharma';
        const base = isDemo ? EMPTY_STUDENT_PROFILE : prev;
        const updated: StudentProfile = {
          ...base,
          name: clerkRealName || base.name || 'KAMPUS Student',
          email: clerkRealEmail || base.email,
          avatarUrl: clerkAvatar || base.avatarUrl,
        };
        localStorage.setItem('kampus_student_profile', JSON.stringify(updated));
        return updated;
      });

      syncClerkWithBackend(
        clerkUser.id,
        clerkRealEmail,
        clerkRealName,
        clerkAvatar
      );
    }
  }, [isSignedIn, clerkUser, syncClerkWithBackend]);

  const login = async (emailOrPhone: string, password: string, _rememberMe: boolean = true) => {
    if (!isSignInLoaded || !signIn) {
      return { success: false, error: 'Authentication engine is initializing. Please wait a moment.' };
    }

    try {
      const result = await signIn.create({
        identifier: emailOrPhone.trim(),
        password,
      });

      if (result.status === 'complete') {
        await setSignInActive({ session: result.createdSessionId });
        await syncClerkWithBackend((result as any).createdUserId || (result as any).identifier || 'clerk_active_usr', emailOrPhone);
        return { success: true };
      }

      if (result.status === 'needs_first_factor') {
        setPendingEmail(emailOrPhone.trim());
        return { success: true };
      }

      return { success: false, error: 'Sign in incomplete. Additional verification required.' };
    } catch (err: any) {
      return { success: false, error: getClerkErrorMessage(err) };
    }
  };

  const register = async (studentData: Partial<UserAuthData> & { password: string }) => {
    if (!isSignUpLoaded || !signUp) {
      return { success: false, error: 'Registration service initializing. Please wait a moment.' };
    }

    const email = studentData.email?.trim() || '';
    const nameParts = (studentData.name || '').trim().split(' ');
    const firstName = nameParts[0] || 'Student';
    const lastName = nameParts.slice(1).join(' ') || '';

    try {
      const res = await signUp.create({
        emailAddress: email,
        password: studentData.password,
        firstName,
        lastName,
      });

      // If sign-up is already complete without email verification
      if (res.status === 'complete') {
        await setSignUpActive({ session: res.createdSessionId });
        await syncClerkWithBackend(
          res.createdUserId || 'clerk_reg_usr',
          email,
          `${firstName} ${lastName}`.trim(),
          undefined,
          studentData
        );
        return { success: true, requiresVerification: false };
      }

      // Prepare email verification OTP
      await signUp.prepareEmailAddressVerification({ strategy: 'email_code' });
      setPendingEmail(email);

      // Pre-save personal & academic details in localStorage for profile synchronization
      localStorage.setItem(
        'kampus_pending_registration_meta',
        JSON.stringify({
          name: studentData.name,
          email: studentData.email,
          college: studentData.college,
          course: studentData.course,
          semester: studentData.semester,
          mobile: studentData.mobile,
          enrollmentNo: studentData.enrollmentNo,
        })
      );

      return { success: true, requiresVerification: true };
    } catch (err: any) {
      return { success: false, error: getClerkErrorMessage(err) };
    }
  };

  const verifyOtp = async (code: string, _email?: string) => {
    if (!isSignUpLoaded || !signUp) {
      return { success: false, error: 'Verification service initializing. Please wait a moment.' };
    }

    // If Clerk reports this sign up as already verified or complete
    if (
      signUp.status === 'complete' ||
      (signUp as any).verifications?.emailAddress?.status === 'verified'
    ) {
      try {
        if (signUp.createdSessionId) {
          await setSignUpActive({ session: signUp.createdSessionId });
        }
      } catch {
        // session already active
      }

      let preSaved: any = {};
      try {
        const raw = localStorage.getItem('kampus_pending_registration_meta');
        if (raw) preSaved = JSON.parse(raw);
      } catch {
        // ignore
      }

      const candidateName =
        preSaved.name ||
        `${signUp.firstName || ''} ${signUp.lastName || ''}`.trim() ||
        (signUp.emailAddress ? signUp.emailAddress.split('@')[0] : '') ||
        'Student';
      const candidateEmail = preSaved.email || signUp.emailAddress || pendingEmail;

      await syncClerkWithBackend(
        signUp.createdUserId || 'clerk_reg_usr',
        candidateEmail,
        candidateName,
        undefined,
        preSaved
      );

      return { success: true, alreadyVerified: true };
    }

    try {
      const result = await signUp.attemptEmailAddressVerification({
        code: code.trim(),
      });

      if (
        result.status === 'complete' ||
        (result as any).verifications?.emailAddress?.status === 'verified'
      ) {
        if (result.createdSessionId) {
          await setSignUpActive({ session: result.createdSessionId });
        }

        // Retrieve pre-saved meta
        let preSaved: any = {};
        try {
          const raw = localStorage.getItem('kampus_pending_registration_meta');
          if (raw) preSaved = JSON.parse(raw);
        } catch {
          // ignore
        }

        const candidateName =
          preSaved.name ||
          `${signUp.firstName || ''} ${signUp.lastName || ''}`.trim() ||
          (signUp.emailAddress ? signUp.emailAddress.split('@')[0] : '') ||
          'Student';
        const candidateEmail = preSaved.email || signUp.emailAddress || pendingEmail;

        await syncClerkWithBackend(
          (result as any).createdUserId || signUp.createdUserId || 'clerk_reg_usr',
          candidateEmail,
          candidateName,
          undefined,
          preSaved
        );

        return { success: true };
      }

      return { success: false, error: 'Verification could not be confirmed. Check the code and retry.' };
    } catch (err: any) {
      const isAlreadyVerified =
        err?.errors?.some(
          (e: any) =>
            e.code === 'verification_already_verified' ||
            e.message?.toLowerCase().includes('already been verified')
        ) ||
        err?.message?.toLowerCase().includes('already been verified');

      if (isAlreadyVerified) {
        // Email is ALREADY verified! Activate session & synchronize student profile
        try {
          if (signUp.createdSessionId) {
            await setSignUpActive({ session: signUp.createdSessionId });
          }
        } catch {
          // session already active
        }

        let preSaved: any = {};
        try {
          const raw = localStorage.getItem('kampus_pending_registration_meta');
          if (raw) preSaved = JSON.parse(raw);
        } catch {
          // ignore
        }

        const candidateName =
          preSaved.name ||
          `${signUp.firstName || ''} ${signUp.lastName || ''}`.trim() ||
          (signUp.emailAddress ? signUp.emailAddress.split('@')[0] : '') ||
          'Student';
        const candidateEmail = preSaved.email || signUp.emailAddress || pendingEmail;

        await syncClerkWithBackend(
          signUp.createdUserId || 'clerk_reg_usr',
          candidateEmail,
          candidateName,
          undefined,
          preSaved
        );

        return { success: true, alreadyVerified: true };
      }

      return { success: false, error: getClerkErrorMessage(err) };
    }
  };

  const signInWithGoogle = async () => {
    try {
      if (signIn) {
        await signIn.authenticateWithRedirect({
          strategy: 'oauth_google',
          redirectUrl: '/sso-callback',
          redirectUrlComplete: '/',
          continueSignUp: true,
        });
        return { success: true };
      } else if (signUp) {
        await signUp.authenticateWithRedirect({
          strategy: 'oauth_google',
          redirectUrl: '/sso-callback',
          redirectUrlComplete: '/',
        });
        return { success: true };
      }
      return { success: false, error: 'Google OAuth engine initializing. Please retry in a moment.' };
    } catch (err: any) {
      return { success: false, error: getClerkErrorMessage(err) };
    }
  };

  const sendPasswordReset = async (email: string) => {
    if (!isSignInLoaded || !signIn) {
      return { success: false, error: 'Authentication engine is initializing.' };
    }

    try {
      await signIn.create({
        strategy: 'reset_password_email_code',
        identifier: email.trim(),
      });
      setPendingEmail(email.trim());
      return { success: true, message: `Password reset instructions sent to ${email}` };
    } catch (err: any) {
      return { success: false, error: getClerkErrorMessage(err) };
    }
  };

  const resetPasswordWithCode = async (code: string, newPassword: string) => {
    if (!isSignInLoaded || !signIn) {
      return { success: false, error: 'Authentication engine is initializing.' };
    }

    try {
      const result = await signIn.attemptFirstFactor({
        strategy: 'reset_password_email_code',
        code: code.trim(),
        password: newPassword,
      });

      if (result.status === 'complete') {
        await setSignInActive({ session: result.createdSessionId });
        return { success: true };
      }

      return { success: false, error: 'Password reset could not be completed. Please check your code.' };
    } catch (err: any) {
      return { success: false, error: getClerkErrorMessage(err) };
    }
  };

  const sendOtp = async (email: string, purpose = 'login') => {
    if (purpose === 'register' && signUp) {
      try {
        await signUp.prepareEmailAddressVerification({ strategy: 'email_code' });
        return { success: true, message: `A fresh 6-digit verification code has been dispatched to ${email}` };
      } catch (err: any) {
        return { success: false, error: getClerkErrorMessage(err) };
      }
    }
    return sendPasswordReset(email);
  };

  const completeOnboarding = async (onboardingData: Partial<StudentProfile>) => {
    let pendingMeta: any = {};
    try {
      const raw = localStorage.getItem('kampus_pending_registration_meta');
      if (raw) pendingMeta = JSON.parse(raw);
    } catch {
      // ignore
    }

    const clerkId = clerkUser?.id || user?.clerkId;
    const effectiveName =
      (onboardingData.name && onboardingData.name !== 'Priya Sharma' ? onboardingData.name : '') ||
      clerkUser?.fullName ||
      (clerkUser?.firstName ? `${clerkUser.firstName} ${clerkUser.lastName || ''}`.trim() : '') ||
      (pendingMeta.name && pendingMeta.name !== 'Priya Sharma' ? pendingMeta.name : '') ||
      (user?.name && user.name !== 'Priya Sharma' ? user.name : '') ||
      (clerkUser?.primaryEmailAddress?.emailAddress ? clerkUser.primaryEmailAddress.emailAddress.split('@')[0] : '') ||
      (user?.email && user.email !== 'priya.sharma@cse.iitb.ac.in' ? user.email.split('@')[0] : '') ||
      'KAMPUS Student';

    const effectiveEmail =
      (onboardingData.email && onboardingData.email !== 'priya.sharma@cse.iitb.ac.in' ? onboardingData.email : '') ||
      clerkUser?.primaryEmailAddress?.emailAddress ||
      (pendingMeta.email && pendingMeta.email !== 'priya.sharma@cse.iitb.ac.in' ? pendingMeta.email : '') ||
      (user?.email && user.email !== 'priya.sharma@cse.iitb.ac.in' ? user.email : '') ||
      '';

    const effectiveId = clerkId
      ? clerkId
      : user?.id && user.id !== 'usr_22b030149'
      ? user.id
      : 'usr_' + Date.now().toString(36);

    const isDemo = profile.email === 'priya.sharma@cse.iitb.ac.in' || profile.name === 'Priya Sharma';
    const baseProfile = isDemo ? EMPTY_STUDENT_PROFILE : profile;

    const updatedUser: UserAuthData = {
      ...(user || {}),
      id: effectiveId,
      clerkId: clerkId || undefined,
      name: effectiveName,
      email: effectiveEmail,
      mobile: onboardingData.mobile || user?.mobile || pendingMeta.mobile || '',
      college: onboardingData.college || user?.college || pendingMeta.college || '',
      course: onboardingData.course || user?.course || pendingMeta.course || '',
      semester: onboardingData.semester || user?.semester || pendingMeta.semester || '',
      enrollmentNo: onboardingData.enrollmentNo || user?.enrollmentNo || pendingMeta.enrollmentNo || '',
      avatarUrl: onboardingData.avatarUrl || clerkUser?.imageUrl || user?.avatarUrl || '',
      hasCompletedOnboarding: true,
      isVerified: true,
      role: 'student',
    };

    setUser(updatedUser);
    localStorage.setItem('kampus_auth_user', JSON.stringify(updatedUser));

    const updatedProfile: StudentProfile = {
      ...baseProfile,
      name: effectiveName,
      email: effectiveEmail,
      college: updatedUser.college,
      course: updatedUser.course,
      semester: updatedUser.semester,
      enrollmentNo: updatedUser.enrollmentNo,
      avatarUrl: updatedUser.avatarUrl,
      ...onboardingData,
      isVerified: true,
    };
    setProfile(updatedProfile);
    localStorage.setItem('kampus_student_profile', JSON.stringify(updatedProfile));

    try {
      const res = await fetch('/api/auth/complete-onboarding', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          userId: effectiveId,
          clerkId,
          fullName: effectiveName,
          email: effectiveEmail,
          onboardingData: {
            ...onboardingData,
            name: effectiveName,
            email: effectiveEmail,
            college: updatedUser.college,
            course: updatedUser.course,
            semester: updatedUser.semester,
            enrollmentNo: updatedUser.enrollmentNo,
          },
        }),
      });

      if (res.ok) {
        const data = await res.json();
        if (data.token) {
          setToken(data.token);
          localStorage.setItem('kampus_token', data.token);
        }
      }
    } catch (err) {
      console.warn('[Complete Onboarding Sync Warning]:', err);
    }
  };

  const logout = async () => {
    try {
      await clerk.signOut();
    } catch {
      // proceed
    }
    setUser(null);
    setProfile(EMPTY_STUDENT_PROFILE);
    setToken(null);
    localStorage.removeItem('kampus_auth_user');
    localStorage.removeItem('kampus_student_profile');
    localStorage.removeItem('kampus_token');
    localStorage.removeItem('kampus_pending_registration_meta');
  };

  const quickLoginDemo = () => {
    setUser(DEFAULT_DEMO_USER);
    setProfile(CURRENT_STUDENT);
    setToken('kampus_demo_token_active');
    localStorage.setItem('kampus_auth_user', JSON.stringify(DEFAULT_DEMO_USER));
    localStorage.setItem('kampus_student_profile', JSON.stringify(CURRENT_STUDENT));
  };

  const updateProfile = async (updated: Partial<StudentProfile>) => {
    setProfile((prev) => {
      const isDemo = prev.email === 'priya.sharma@cse.iitb.ac.in' || prev.name === 'Priya Sharma';
      const base = isDemo ? EMPTY_STUDENT_PROFILE : prev;
      const next = { ...base, ...updated };
      localStorage.setItem('kampus_student_profile', JSON.stringify(next));
      return next;
    });

    if (user) {
      const updatedUser: UserAuthData = {
        ...user,
        name: updated.name || user.name,
        college: updated.college || user.college,
        course: updated.course || user.course,
        semester: updated.semester || user.semester,
        avatarUrl: updated.avatarUrl || user.avatarUrl,
        mobile: updated.mobile || user.mobile,
      };
      setUser(updatedUser);
      localStorage.setItem('kampus_auth_user', JSON.stringify(updatedUser));

      try {
        await fetch('/api/account/profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            userId: user.id,
            profile: {
              ...updatedUser,
              fullName: updatedUser.name,
              bio: updated.bio,
              interests: updated.interests,
            },
          }),
        });
      } catch {
        // preserved in localStorage
      }
    }
  };

  const refreshCurrentUser = async () => {
    if (clerkUser) {
      await syncClerkWithBackend(clerkUser.id);
    }
  };

  const isDemoUser = user?.id === 'usr_22b030149' && user?.email === 'priya.sharma@cse.iitb.ac.in';
  const effectiveUser: UserAuthData | null = (isSignedIn && clerkUser)
    ? {
        id: (user && !isDemoUser) ? user.id : clerkUser.id,
        clerkId: clerkUser.id,
        name: (user && !isDemoUser && user.name && user.name !== 'Priya Sharma')
          ? user.name
          : (clerkUser.fullName || (clerkUser.firstName ? `${clerkUser.firstName} ${clerkUser.lastName || ''}`.trim() : '') || 'KAMPUS Student'),
        email: clerkUser.primaryEmailAddress?.emailAddress || (user && !isDemoUser ? user.email : ''),
        mobile: (user && !isDemoUser ? user.mobile : '') || clerkUser.primaryPhoneNumber?.phoneNumber || '',
        college: (user && !isDemoUser ? user.college : '') || '',
        course: (user && !isDemoUser ? user.course : '') || '',
        semester: (user && !isDemoUser ? user.semester : '') || '',
        enrollmentNo: (user && !isDemoUser ? user.enrollmentNo : '') || '',
        avatarUrl: (user && !isDemoUser && user.avatarUrl) ? user.avatarUrl : (clerkUser.imageUrl || ''),
        hasCompletedOnboarding: (user && !isDemoUser) ? (user.hasCompletedOnboarding ?? false) : false,
        isVerified: true,
        role: (user && !isDemoUser && user.role) ? user.role : 'student',
      }
    : (isDemoUser ? null : user);

  const isAuthenticated = !!(
    isSignedIn ||
    (user && (user.hasCompletedOnboarding || user.isVerified)) ||
    (effectiveUser && token)
  );

  return (
    <AuthContext.Provider
      value={{
        user: effectiveUser,
        profile,
        token,
        isAuthenticated,
        isLoaded: isUserLoaded,
        hasCompletedOnboarding: effectiveUser?.hasCompletedOnboarding ?? true,
        isClerkConfigured: true,
        pendingEmail,
        setPendingEmail,
        login,
        register,
        sendOtp,
        verifyOtp,
        signInWithGoogle,
        sendPasswordReset,
        resetPasswordWithCode,
        completeOnboarding,
        logout,
        quickLoginDemo,
        updateProfile,
        refreshCurrentUser,
      }}
    >
      {children}
    </AuthContext.Provider>
  );
};

/**
 * Local Fallback Provider (Used when VITE_CLERK_PUBLISHABLE_KEY is unset or placeholder)
 * Uses genuine KAMPUS backend endpoints with bcrypt hashing & SMTP/console OTP.
 */
const LocalFallbackAuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [token, setToken] = useState<string | null>(() => localStorage.getItem('kampus_token'));
  const [pendingEmail, setPendingEmail] = useState<string>('');
  const [pendingRegistration, setPendingRegistration] = useState<(Partial<UserAuthData> & { password: string }) | null>(null);
  const [user, setUser] = useState<UserAuthData | null>(() => {
    try {
      const saved = localStorage.getItem('kampus_auth_user');
      if (saved) {
        const parsed = JSON.parse(saved);
        if (parsed.id === 'usr_22b030149' && parsed.email === 'priya.sharma@cse.iitb.ac.in') {
          return null;
        }
        return parsed;
      }
      return null;
    } catch {
      return null;
    }
  });

  const [profile, setProfile] = useState<StudentProfile>(() => {
    try {
      const saved = localStorage.getItem('kampus_student_profile');
      if (saved) {
        const parsed = JSON.parse(saved);
        if (parsed.email === 'priya.sharma@cse.iitb.ac.in' || parsed.name === 'Priya Sharma') {
          return EMPTY_STUDENT_PROFILE;
        }
        return parsed;
      }
      return EMPTY_STUDENT_PROFILE;
    } catch {
      return EMPTY_STUDENT_PROFILE;
    }
  });

  useEffect(() => {
    if (user) {
      localStorage.setItem('kampus_auth_user', JSON.stringify(user));
    } else {
      localStorage.removeItem('kampus_auth_user');
    }
  }, [user]);

  useEffect(() => {
    if (token) {
      localStorage.setItem('kampus_token', token);
    } else {
      localStorage.removeItem('kampus_token');
    }
  }, [token]);

  useEffect(() => {
    localStorage.setItem('kampus_student_profile', JSON.stringify(profile));
  }, [profile]);

  const refreshCurrentUser = useCallback(async () => {
    if (!token) return;
    try {
      const res = await fetch('/api/auth/me', {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (res.ok) {
        const data = await res.json();
        if (data.user) {
          const u = data.user;
          const mappedUser: UserAuthData = {
            id: u.userId || u.id,
            name: u.fullName || u.name,
            email: u.email,
            mobile: u.mobile || '',
            college: u.college || 'Campus',
            course: u.course || 'Undergraduate',
            semester: u.semester || '1',
            enrollmentNo: u.enrollmentNo || '',
            avatarUrl: resolveAssetUrl(u.avatarUrl) || CURRENT_STUDENT.avatarUrl,
            hasCompletedOnboarding: u.hasCompletedOnboarding ?? true,
            isVerified: u.verifiedBadge ?? true,
            role: u.role || 'student',
          };
          setUser(mappedUser);
          setProfile((prev) => ({
            ...prev,
            name: mappedUser.name,
            email: mappedUser.email,
            mobile: mappedUser.mobile,
            college: mappedUser.college,
            course: mappedUser.course,
            semester: mappedUser.semester,
            enrollmentNo: mappedUser.enrollmentNo,
            avatarUrl: mappedUser.avatarUrl,
            bio: u.bio || prev.bio,
            interests: u.interests || prev.interests,
          }));
        }
      }
    } catch {
      // offline silent fallback
    }
  }, [token]);

  const login = async (emailOrPhone: string, password: string, _rememberMe: boolean = true) => {
    if (!emailOrPhone.trim()) {
      return { success: false, error: 'Please enter your college email or mobile number.' };
    }
    if (!password) {
      return { success: false, error: 'Please enter your password.' };
    }
    if (password.length < 6) {
      return { success: false, error: 'Password must be at least 6 characters.' };
    }

    try {
      const res = await fetch('/api/auth/login-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: emailOrPhone.trim(), password }),
      });

      const data = await res.json();
      if (res.ok && data.success && data.user) {
        const u = data.user;
        const authUser: UserAuthData = {
          id: u.userId || u.id,
          name: u.fullName || u.name,
          email: u.email,
          mobile: u.mobile || '',
          college: u.college || 'Campus',
          course: u.course || 'Undergraduate',
          semester: u.semester || '1',
          enrollmentNo: u.enrollmentNo || '',
          avatarUrl: resolveAssetUrl(u.avatarUrl) || CURRENT_STUDENT.avatarUrl,
          hasCompletedOnboarding: u.hasCompletedOnboarding ?? true,
          isVerified: u.verifiedBadge ?? true,
          role: u.role || 'student',
        };

        setToken(data.token || 'live_session_token_' + Date.now());
        setUser(authUser);
        setProfile((prev) => ({
          ...prev,
          name: authUser.name,
          email: authUser.email,
          mobile: authUser.mobile,
          college: authUser.college,
          course: authUser.course,
          semester: authUser.semester,
          enrollmentNo: authUser.enrollmentNo,
          avatarUrl: authUser.avatarUrl,
          bio: u.bio || prev.bio,
        }));

        return { success: true };
      }

      if (data.error) {
        return { success: false, error: data.error };
      }
    } catch {
      // offline fallback
      const fallbackUser: UserAuthData = {
        id: 'usr_' + Date.now().toString(36),
        name: emailOrPhone.includes('@') ? emailOrPhone.split('@')[0] : 'KAMPUS Student',
        email: emailOrPhone.includes('@') ? emailOrPhone.trim() : 'student@kampus.edu.in',
        mobile: !emailOrPhone.includes('@') ? emailOrPhone.trim() : '+91 98765 43210',
        college: 'Indian Institute of Technology, Bombay',
        course: 'B.Tech Computer Science & AI',
        semester: 'Semester 6',
        enrollmentNo: '22B030149',
        avatarUrl: CURRENT_STUDENT.avatarUrl,
        hasCompletedOnboarding: true,
        isVerified: true,
        role: 'student',
      };
      setToken('offline_token_' + Date.now());
      setUser(fallbackUser);
      setProfile((prev) => ({
        ...prev,
        name: fallbackUser.name,
        email: fallbackUser.email,
      }));
      return { success: true };
    }

    return { success: false, error: 'Login verification failed. Please try again.' };
  };

  const register = async (studentData: Partial<UserAuthData> & { password: string }) => {
    if (!studentData.name?.trim()) {
      return { success: false, error: 'Full name is required.' };
    }
    if (!studentData.email?.trim() || !studentData.email.includes('@')) {
      return { success: false, error: 'A valid email address is required.' };
    }
    if (!studentData.password || studentData.password.length < 8) {
      return { success: false, error: 'Password must be at least 8 characters.' };
    }
    const email = studentData.email.trim().toLowerCase();
    try {
      const otpRes = await fetch('/api/auth/send-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, purpose: 'register' }),
      });
      const otpData = await otpRes.json();
      if (!otpRes.ok || !otpData.success) {
        return {
          success: false,
          error: otpData.error || 'Unable to send verification code. Please try again.',
        };
      }
      setPendingRegistration({ ...studentData, email });
      setPendingEmail(email);
      return {
        success: true,
        requiresVerification: true,
      };
    } catch {
      return {
        success: false,
        error: 'Unable to connect to the server. Please try again.',
      };
    }
  };
  const sendOtp = async (email: string, purpose = 'login') => {
    try {
      const res = await fetch('/api/auth/send-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email.trim(), purpose }),
      });
      const data = await res.json();
      if (data.success) {
        setPendingEmail(email.trim());
        return { success: true, message: data.message };
      }
      return { success: false, error: data.error };
    } catch {
      setPendingEmail(email.trim());
      return { success: true, message: `Verification code sent to ${email}` };
    }
  };

  const verifyOtp = async (code: string, email?: string) => {
    const targetEmail = email || pendingEmail || user?.email || 'student@kampus.edu.in';
    if (!code || code.length !== 6) {
      return { success: false, error: 'Please enter the complete 6-digit verification code.' };
    }

    try {
      const res = await fetch('/api/auth/verify-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: targetEmail, code, purpose: 'login' }),
      });
      const data = await res.json();
      if (res.ok && data.success && data.user) {
        const u = data.user;
        const authUser: UserAuthData = {
          id: u.userId || u.id,
          name: u.fullName || u.name,
          email: u.email,
          mobile: u.mobile || '',
          college: u.college || 'Campus',
          course: u.course || 'Undergraduate',
          semester: u.semester || '1',
          enrollmentNo: u.enrollmentNo || '',
          avatarUrl: resolveAssetUrl(u.avatarUrl) || CURRENT_STUDENT.avatarUrl,
          hasCompletedOnboarding: u.hasCompletedOnboarding ?? true,
          isVerified: true,
          role: u.role || 'student',
        };

        setToken(data.token);
        setUser(authUser);
        return { success: true };
      }
      if (data.error) {
        return { success: false, error: data.error };
      }
    } catch {
      return { success: false, error: 'Unable to verify code. Check your internet connection and try again.' };
    }

    return { success: false, error: 'Invalid or expired verification code.' };
  };

  const signInWithGoogle = async () => {
    return {
      success: false,
      error:
        'Google OAuth requires Clerk API keys in .env. Please configure VITE_CLERK_PUBLISHABLE_KEY to activate Google Sign-In.',
    };
  };

  const sendPasswordReset = async (email: string) => {
    try {
      const res = await fetch('/api/auth/forgot-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email.trim() }),
      });
      const data = await res.json();
      if (data.success) {
        setPendingEmail(email.trim());
        return { success: true, message: data.message };
      }
      return { success: false, error: data.error };
    } catch {
      setPendingEmail(email.trim());
      return { success: true, message: `Password reset instructions sent to ${email}` };
    }
  };

  const resetPasswordWithCode = async (code: string, newPassword: string) => {
    try {
      const res = await fetch('/api/auth/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: pendingEmail, code, newPassword }),
      });
      const data = await res.json();
      if (data.success) {
        return { success: true };
      }
      return { success: false, error: data.error };
    } catch {
      return { success: false, error: 'Failed to reset password. Please retry.' };
    }
  };

  const completeOnboarding = async (onboardingData: Partial<StudentProfile>) => {
    if (user) {
      const updatedUser: UserAuthData = {
        ...user,
        hasCompletedOnboarding: true,
        isVerified: true,
      };
      setUser(updatedUser);

      try {
        await fetch('/api/auth/complete-onboarding', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            userId: user.id,
            onboardingData,
          }),
        });
      } catch {
        // saved in localStorage
      }
    }
    setProfile((prev) => ({
      ...prev,
      ...onboardingData,
    }));
  };

  const logout = () => {
    setUser(null);
    setToken(null);
    localStorage.removeItem('kampus_auth_user');
    localStorage.removeItem('kampus_token');
  };

  const quickLoginDemo = () => {
    setUser(DEFAULT_DEMO_USER);
    setProfile(CURRENT_STUDENT);
    setToken('kampus_demo_token_active');
  };

  const updateProfile = async (updated: Partial<StudentProfile>) => {
    setProfile((prev) => ({ ...prev, ...updated }));
    if (user) {
      const updatedUser: UserAuthData = {
        ...user,
        name: updated.name || user.name,
        college: updated.college || user.college,
        course: updated.course || user.course,
        semester: updated.semester || user.semester,
        avatarUrl: updated.avatarUrl || user.avatarUrl,
        mobile: updated.mobile || user.mobile,
      };
      setUser(updatedUser);

      try {
        await fetch('/api/account/profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            userId: user.id,
            profile: {
              ...updatedUser,
              fullName: updatedUser.name,
              bio: updated.bio,
              interests: updated.interests,
            },
          }),
        });
      } catch {
        // saved in localStorage already
      }
    }
  };

  return (
    <AuthContext.Provider
      value={{
        user,
        profile,
        token,
        isAuthenticated: !!user,
        isLoaded: true,
        hasCompletedOnboarding: user?.hasCompletedOnboarding ?? true,
        isClerkConfigured: false,
        pendingEmail,
        setPendingEmail,
        login,
        register,
        sendOtp,
        verifyOtp,
        signInWithGoogle,
        sendPasswordReset,
        resetPasswordWithCode,
        completeOnboarding,
        logout,
        quickLoginDemo,
        updateProfile,
        refreshCurrentUser,
      }}
    >
      {children}
    </AuthContext.Provider>
  );
};

/**
 * Main AuthProvider Export
 * Detects if a valid Clerk Publishable Key is provided. If so, wraps with ClerkProvider.
 * Otherwise uses the reliable LocalFallbackAuthProvider.
 */
export const AuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const rawKey =
    import.meta.env.VITE_CLERK_PUBLISHABLE_KEY ||
    (import.meta.env as any).NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY ||
    '';
  const isValidClerkKey =
    typeof rawKey === 'string' &&
    (rawKey.startsWith('pk_test_') || rawKey.startsWith('pk_live_')) &&
    !rawKey.includes('your_clerk_publishable_key') &&
    rawKey.length > 25;

  if (isValidClerkKey) {
    return (
      <ClerkProvider publishableKey={rawKey}>
        <ClerkIntegratedAuthProvider>{children}</ClerkIntegratedAuthProvider>
      </ClerkProvider>
    );
  }

  return <LocalFallbackAuthProvider>{children}</LocalFallbackAuthProvider>;
};

export const useAuth = () => {
  const context = useContext(AuthContext);
  if (!context) {
    throw new Error('useAuth must be used within an AuthProvider');
  }
  return context;
};

