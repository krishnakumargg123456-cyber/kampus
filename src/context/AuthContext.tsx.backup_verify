import React, { createContext, useContext, useState, useEffect, useCallback } from 'react';
import { ClerkProvider, useUser, useAuth as useClerkAuth, useClerk } from "@clerk/react";
import { useSignIn, useSignUp } from "@clerk/react/legacy";
import { UserAuthData, StudentProfile } from '../types';
import { CURRENT_STUDENT } from '../data/mockData';
import { resolveAssetUrl } from '../utils/assetResolver';

export interface AuthContextType {
  user: UserAuthData | null;
  profile: StudentProfile;
  token: string | null;
  isAuthenticated: boolean;
  isLoaded: boolean;
  hasCompletedOnboarding: boolean;
  isClerkConfigured: boolean;
  pendingEmail: string;
  setPendingEmail: (email: string) => void;
  login: (emailOrPhone: string, password: string, rememberMe?: boolean) => Promise<{ success: boolean; error?: string }>;
  register: (studentData: Partial<UserAuthData> & { password: string }) => Promise<{ success: boolean; error?: string; requiresVerification?: boolean }>;
  sendOtp: (email: string, purpose?: string) => Promise<{ success: boolean; message?: string; error?: string }>;
  verifyOtp: (code: string, email?: string) => Promise<{ success: boolean; error?: string }>;
  signInWithGoogle: () => Promise<{ success: boolean; error?: string }>;
  sendPasswordReset: (email: string) => Promise<{ success: boolean; message?: string; error?: string }>;
  resetPasswordWithCode: (code: string, newPassword: string) => Promise<{ success: boolean; error?: string }>;
  completeOnboarding: (onboardingData: Partial<StudentProfile>) => Promise<void>;
  logout: () => void;
  quickLoginDemo: () => void;
  updateProfile: (updated: Partial<StudentProfile>) => Promise<void>;
  refreshCurrentUser: () => Promise<void>;
}

