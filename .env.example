# ========================================================
# KAMPUS – ENVIRONMENT CONFIGURATION SPECIFICATION
# ========================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=development

# ========================================================
# Clerk Authentication (Required for Cloud Auth & Google OAuth)
# ========================================================
# 1. Sign up at https://dashboard.clerk.com and create an application.
# 2. In Clerk Dashboard > User & Authentication > Email, Phone, Username:
#    - Turn ON "Email address" and "Email verification code".
# 3. In Clerk Dashboard > User & Authentication > Social Connections:
#    - Enable "Google" OAuth.
# 4. In Clerk Dashboard > API Keys:
#    - Copy your Publishable Key and Secret Key below.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Google Gemini AI Integration (Required for KAMPUS AI & Document Analysis)
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# JWT & Session Security
# Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_characters

# Production PostgreSQL Database Connection
# Format: postgres://username:password@hostname:5432/database_name
# If omitted, KAMPUS runs in local high-resilience persistent JSON storage mode.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kampus_db
DATABASE_SSL=false

# Real Email OTP & System Notifications Gateway (Nodemailer / SMTP)
# Provide SMTP credentials for sending live 6-digit verification codes to student emails.
# If omitted during local testing, OTP codes are securely output directly in server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_verified_service_email@gmail.com
SMTP_PASS=your_app_specific_password_here
SMTP_FROM="KAMPUS Student App" <noreply@kampus.edu.in>

# Super Admin Initial Master Passkey
# Used for initial bootstrapping of the Super Admin Control Center
SUPER_ADMIN_BOOTSTRAP_PASSKEY=KAMPUS_SUPER_ADMIN_MASTER_2026
